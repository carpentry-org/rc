(system-include "stdint.h")

(doc Rc "Generic single-threaded reference counting (Rust-like `Rc`/`Weak`).

`(Rc a)` is a transparent generic type: there is no per-type macro, so it can
be used directly and, crucially, in recursive types via the compiler's
`recursive` flag, e.g.

  (deftype (Lst a) (Cons [a (Rc (Lst a))]) (Nil []))

Drops recurse on the C call stack, so very deep (non-logarithmic) `Rc` chains
can overflow it. For tree-shaped or log-depth structures this is not a concern.")

(doc RcCell "The reference-counting control block shared by `Rc` and `Weak`.

The payload lives inline, so a strong reference is a single allocation.")
(deftype (RcCell a) [strong Long weak Long live Bool value a])
(hidden RcCell)

(deftype (Rc a) [cell (Ptr (RcCell a))])
(recursive Rc)

(deftype (Weak a) [cell (Ptr (RcCell a))])
(recursive Weak)

(defmodule Rc
  (doc checks-enabled?
    "Whether runtime safety checks (refcount overflow/underflow) run.

Follows C `assert` semantics: checks are compiled out when `NDEBUG` is
defined, which `carp --optimize` does. Debug builds keep full checking.")
  (deftemplate checks-enabled? (Fn [] Bool)
    "bool $NAME()"
    "$DECL {
#ifdef NDEBUG
    return false;
#else
    return true;
#endif
}")

  (hidden alloc-checked)
  (deftemplate alloc-checked (Fn [a] (Ptr a))
    "$a* $NAME($a value)"
    "$DECL { $a* ptr = ($a*)CARP_MALLOC(sizeof($a)); if (!ptr) { abort(); } *ptr = value; return ptr; }")

  (hidden checked-inc)
  (sig checked-inc (Fn [Long] Long))
  (defn checked-inc [n]
    (if (checks-enabled?)
      (if (= n Long.MAX) (unreachable "Rc refcount overflow") (Long.inc n))
      (Long.inc n)))

  (hidden checked-dec)
  (sig checked-dec (Fn [Long] Long))
  (defn checked-dec [n]
    (if (checks-enabled?)
      (if (> n 0l) (Long.dec n) (unreachable "Rc refcount underflow"))
      (Long.dec n)))

  (hidden cref) (private cref)
  (sig cref (Fn [(Ref (Rc a) q)] (Ref (RcCell a) q)))
  (defn cref [rc-ref] (Pointer.to-ref @(Rc.cell rc-ref)))

  ; --- per-type cell freelist ---
  ; All cells of one (RcCell a) instantiation are the same size, so freed cells
  ; are recycled through a per-type pool instead of round-tripping the system
  ; allocator on every node create/drop (persistent writes are malloc-bound).
  ; op 0 pops a recycled cell (or NULL); op 1 pushes a cell to the pool. Under
  ; LOG_MEMORY the pool is bypassed so memory-balance accounting stays exact:
  ; op 0 returns NULL (caller mallocs), op 1 returns the cell (caller frees).
  (hidden cell-pool)
  (deftemplate cell-pool (Fn [(Ptr (RcCell a)) Int] (Ptr (RcCell a)))
    "void* $NAME(void* p, int op)"
    "$DECL {
#ifdef LOG_MEMORY
    return op == 1 ? p : NULL;
#else
    static void** pool = NULL; static int plen = 0, pcap = 0;
    if (op == 1) {
      if (plen >= pcap) { pcap = pcap ? pcap * 2 : 256; pool = (void**)realloc(pool, pcap * sizeof(void*)); }
      pool[plen++] = p;
      return NULL;
    }
    return plen > 0 ? pool[--plen] : NULL;
#endif
}")

  (doc new "Create a new strong reference with count `strong=1, weak=0`.

The payload lives inline in the control block: one allocation per `Rc`.")
  (sig new (Fn [a] (Rc a)))
  (defn new [value]
    (let-do [recycled (cell-pool (the (Ptr (RcCell a)) NULL) 0)]
      (if (null? recycled)
        (Rc.init (alloc-checked (RcCell.init 1l 0l true value)))
        (do
          (Pointer.set recycled (RcCell.init 1l 0l true value))
          (Rc.init recycled)))))

  (hidden drop-payload!) (private drop-payload!)
  (sig drop-payload! (Fn [(Ref (RcCell a) q)] ()))
  (defn drop-payload! [cell]
    (do
      (when @(RcCell.live cell)
        (do
          (RcCell.set-live! cell false)
          (ignore (Pointer.to-value (Pointer.address (RcCell.value cell))))))))

  (doc copy "Increment strong count and return the same shared pointer.")
  (sig copy (Fn [(Ref (Rc a) q)] (Rc a)))
  (defn copy [rc-ref]
    (let-do [cell (cref rc-ref)]
      (RcCell.set-strong! cell (checked-inc @(RcCell.strong cell)))
      (Rc.init @(Rc.cell rc-ref))))
  (implements copy Rc.copy)

  (hidden finalize-cell!) (private finalize-cell!)
  (sig finalize-cell! (Fn [(Ptr (RcCell a))] ()))
  (defn finalize-cell! [p]
    (let [cell (Pointer.to-ref p)]
      (if (= @(RcCell.weak cell) 0l)
        (do
          ; the payload was already dropped (or moved out) when `strong` hit
          ; zero, so the raw block is recycled directly; running the generated
          ; cell deleter here would delete the stale inline payload again.
          (let [leftover (cell-pool p 1)]
            (unless (null? leftover) (Pointer.free leftover))))
        (RcCell.set-strong! cell 0l))))

  ; --- iterative drop via a per-type drain queue ---
  ; Each (RcCell a) instantiation gets its own C static queue and `draining`
  ; flag (carried by a dummy cell-pointer arg so the template monomorphizes
  ; per `a`; the pointer's contents are never read). When a drop is already in
  ; progress, deeper same-type cells are queued instead of dropped on the
  ; stack, so a long list or a degenerate heap spine drops iteratively and
  ; cannot overflow the C call stack. Cross-type nesting recurses one level per
  ; type switch (each type has an independent flag), which stays shallow.
  (hidden drain-queue-ptr)
  (deftemplate drain-queue-ptr (Fn [(Ptr (RcCell a))] (Ptr (Array (Ptr (RcCell a)))))
    "Array* $NAME(void* p)"
    "$DECL { (void)p; static Array q = {0, 0, NULL}; return &q; }")

  (hidden drain-flag)
  ; op 0 = read, 1 = set true, 2 = set false; returns the resulting flag.
  (deftemplate drain-flag (Fn [(Ptr (RcCell a)) Int] Bool)
    "bool $NAME(void* p, int op)"
    "$DECL { (void)p; static bool d = false; if (op == 1) { d = true; } else if (op == 2) { d = false; } return d; }")

  ; --- per-type cell freelist ---
  ; All cells of one (RcCell a) instantiation are the same size, so freed cells
  ; are recycled through a per-type pool instead of round-tripping the system
  ; allocator on every node create/drop (persistent writes are malloc-bound).
  ; op 0 pops a recycled cell (or NULL); op 1 pushes a cell to the pool. Under
  ; LOG_MEMORY the pool is bypassed so memory-balance accounting stays exact:
  ; op 0 returns NULL (caller mallocs), op 1 returns the cell (caller frees).
  (hidden drain-step!) (private drain-step!)
  (sig drain-step! (Fn [(Ptr (RcCell a))] ()))
  (defn drain-step! [p]
    (let-do [cell (Pointer.to-ref p)]
      (drop-payload! cell)
      (RcCell.set-weak! cell (checked-dec @(RcCell.weak cell)))
      (finalize-cell! p)))

  (doc delete "Drop one strong reference.

When `strong` reaches zero the payload is dropped and, once `weak=0` too, the
control block is freed. Deep same-type chains drop iteratively via a per-type
drain queue, so they do not overflow the C call stack.")
  (sig delete (Fn [(Rc a)] ()))
  (defn delete [rc]
    (let-do [p @(Rc.cell &rc)
             cell (Pointer.to-ref p)
             strong-n @(RcCell.strong cell)]
      (if (> strong-n 1l)
        (RcCell.set-strong! cell (checked-dec strong-n))
        (if (drain-flag p 0)
          ; a drain is already running: keep this cell alive (bump weak) and
          ; queue it instead of recursing.
          (do
            (RcCell.set-strong! cell 0l)
            (RcCell.set-weak! cell (checked-inc @(RcCell.weak cell)))
            (Array.push-back! (Pointer.to-ref (drain-queue-ptr p)) p))
          ; top of a drop: drop this payload, then process the queue iteratively.
          (do
            (ignore (drain-flag p 1))
            (drop-payload! cell)
            (finalize-cell! p)
            (while-do (> (Array.length (Pointer.to-ref (drain-queue-ptr p))) 0)
              (drain-step! (Array.pop-back! (Pointer.to-ref (drain-queue-ptr p)))))
            (ignore (drain-flag p 2)))))))
  (implements delete Rc.delete)

  (doc strong-count "Get current strong reference count.")
  (sig strong-count (Fn [(Ref (Rc a) q)] Long))
  (defn strong-count [rc-ref]
    (let-do [cell (cref rc-ref)]
      @(RcCell.strong cell)))

  (doc weak-count "Get current weak reference count.")
  (sig weak-count (Fn [(Ref (Rc a) q)] Long))
  (defn weak-count [rc-ref]
    (let-do [cell (cref rc-ref)]
      @(RcCell.weak cell)))

  (doc unique? "Returns `true` when this is the unique strong owner.")
  (sig unique? (Fn [(Ref (Rc a) q)] Bool))
  (defn unique? [rc-ref]
    (= (strong-count rc-ref) 1l))

  (doc clone "Clone an `Rc` by increasing strong count.")
  (sig clone (Fn [(Ref (Rc a) q)] (Rc a)))
  (defn clone [rc-ref]
    (copy rc-ref))

  (doc downgrade "Create a weak reference from a strong one.")
  (sig downgrade (Fn [(Ref (Rc a) q)] (Weak a)))
  (defn downgrade [rc-ref]
    (let-do [cell (cref rc-ref)]
      (RcCell.set-weak! cell (checked-inc @(RcCell.weak cell)))
      (Weak.init @(Rc.cell rc-ref))))

  (doc ptr-eq "Checks whether two `Rc`s point to the same allocation.")
  (sig ptr-eq (Fn [(Ref (Rc a) q) (Ref (Rc a) r)] Bool))
  (defn ptr-eq [a-ref b-ref]
    (Pointer.eq @(Rc.cell a-ref) @(Rc.cell b-ref)))

  (doc get "Copy out the inner value.

Requires a valid, non-expired `Rc` handle.")
  (sig get (Fn [(Ref (Rc a) q)] a))
  (defn get [rc-ref]
    (let-do [cell (cref rc-ref)]
      (if @(RcCell.live cell)
        @(RcCell.value cell)
        (unreachable "Rc.get called on expired value"))))

  (doc value-ref "Borrow the payload in place, without copying.

The returned reference shares the handle's lifetime. Requires a valid,
non-expired `Rc` handle.")
  (sig value-ref (Fn [(Ref (Rc a) q)] (Ref a q)))
  (defn value-ref [rc-ref]
    (let-do [cell (cref rc-ref)]
      (if @(RcCell.live cell)
        (RcCell.value cell)
        (unreachable "Rc.value-ref called on expired value"))))

  (doc try-unwrap "Consume an `Rc` and try to extract the inner value.

Returns `(Result.Success value)` when uniquely owned.
Returns `(Result.Error rc)` unchanged when shared.

On success, extraction moves the payload out of the `Rc` cell without calling
payload delete.")
  (sig try-unwrap (Fn [(Rc a)] (Result a (Rc a))))
  (defn try-unwrap [rc]
    (if (= (strong-count &rc) 1l)
      (let-do [cell (cref &rc)]
        (if (not @(RcCell.live cell))
          (unreachable "Rc.try-unwrap called on expired value")
          (let-do [value (Pointer.to-value (Pointer.address (RcCell.value cell)))]
            (RcCell.set-live! cell false)
            (delete rc)
            (Result.Success value))))
      (Result.Error rc)))

  (doc unwrap "Consume an `Rc` and extract inner value.

Aborts if shared. Requires a valid, non-expired `Rc` handle.")
  (sig unwrap (Fn [(Rc a)] a))
  (defn unwrap [rc]
    (match (try-unwrap rc)
      (Result.Success value) value
      (Result.Error _) (unreachable "Rc.unwrap called on shared value")))

  (doc unwrap-or-clone "Consume an `Rc`; extract when unique, otherwise copy payload.")
  (sig unwrap-or-clone (Fn [(Rc a)] a))
  (defn unwrap-or-clone [rc]
    (match (try-unwrap rc)
      (Result.Success value) value
      (Result.Error rc-back) (get &rc-back)))

  (doc make-unique "Consume an `Rc` and return a uniquely-owned `Rc`.

Requires a valid, non-expired `Rc` handle.")
  (sig make-unique (Fn [(Rc a)] (Rc a)))
  (defn make-unique [rc]
    (if (unique? &rc)
      rc
      (let-do [cell (cref &rc)
               strong-n @(RcCell.strong cell)]
        (if (not @(RcCell.live cell))
          (unreachable "Rc.make-unique called on expired value")
          (let-do [value @(RcCell.value cell)]
            (RcCell.set-strong! cell (checked-dec strong-n))
            (Unsafe.leak rc)
            (new value))))))

  (doc str "Diagnostic formatting with current strong/weak counts.")
  (sig str (Fn [(Ref (Rc a) q)] String))
  (defn str [rc-ref]
    (fmt "(Rc strong=%ld weak=%ld)" (strong-count rc-ref) (weak-count rc-ref)))
  (implements str Rc.str)

  (sig prn (Fn [(Ref (Rc a) q)] String))
  (defn prn [rc-ref] (str rc-ref))
  (implements prn Rc.prn))

(defmodule Weak
  (hidden cptr) (private cptr)
  (sig cptr (Fn [(Ref (Weak a) q)] (Ptr (RcCell a))))
  (defn cptr [w-ref] @(Weak.cell w-ref))

  (doc new "Create an empty weak reference that is immediately expired.")
  (sig new (Fn [] (Weak a)))
  (defn new []
    (Weak.init (the (Ptr (RcCell a)) NULL)))

  (doc copy "Increment weak count and return the same weak pointer.")
  (sig copy (Fn [(Ref (Weak a) q)] (Weak a)))
  (defn copy [w-ref]
    (let-do [p (cptr w-ref)]
      (unless (null? p)
        (let-do [cell (Pointer.to-ref p)]
          (RcCell.set-weak! cell (Rc.checked-inc @(RcCell.weak cell)))))
      (Weak.init p)))
  (implements copy Weak.copy)

  (doc delete "Drop one weak reference.")
  (sig delete (Fn [(Weak a)] ()))
  (defn delete [w]
    (let [p (cptr &w)]
      (unless (null? p)
        (let-do [cell (Pointer.to-ref p)
                 weak-n @(RcCell.weak cell)]
          (if (> weak-n 1l)
            (RcCell.set-weak! cell (Rc.checked-dec weak-n))
            (if (= @(RcCell.strong cell) 0l)
              (do
                ; payload already dropped when strong hit zero; free the raw
                ; block without the cell deleter
                (Pointer.free p))
              (RcCell.set-weak! cell 0l)))))))
  (implements delete Weak.delete)

  (doc clone "Clone a weak reference by increasing weak count.")
  (sig clone (Fn [(Ref (Weak a) q)] (Weak a)))
  (defn clone [w-ref]
    (copy w-ref))

  (doc strong-count "Read current strong count via weak reference.")
  (sig strong-count (Fn [(Ref (Weak a) q)] Long))
  (defn strong-count [w-ref]
    (let [p (cptr w-ref)]
      (if (null? p)
        0l
        (let-do [cell (Pointer.to-ref p)]
          @(RcCell.strong cell)))))

  (doc weak-count "Read current weak count.")
  (sig weak-count (Fn [(Ref (Weak a) q)] Long))
  (defn weak-count [w-ref]
    (let [p (cptr w-ref)]
      (if (null? p)
        0l
        (let-do [cell (Pointer.to-ref p)]
          @(RcCell.weak cell)))))

  (doc expired? "Returns `true` when there are no remaining strong references.")
  (sig expired? (Fn [(Ref (Weak a) q)] Bool))
  (defn expired? [w-ref]
    (= (strong-count w-ref) 0l))

  (doc alive? "Returns `true` while at least one strong reference exists.")
  (sig alive? (Fn [(Ref (Weak a) q)] Bool))
  (defn alive? [w-ref]
    (> (strong-count w-ref) 0l))

  (doc upgrade "Try to obtain a strong reference from a weak one.

Returns `(Maybe.Just rc)` if payload is still alive, otherwise `Nothing`.")
  (sig upgrade (Fn [(Ref (Weak a) q)] (Maybe (Rc a))))
  (defn upgrade [w-ref]
    (let [p (cptr w-ref)]
      (if (null? p)
        (Maybe.Nothing)
        (let-do [cell (Pointer.to-ref p)
                 strong-n @(RcCell.strong cell)]
          (if (> strong-n 0l)
            (do
              (RcCell.set-strong! cell (Rc.checked-inc strong-n))
              (Maybe.Just (Rc.init p)))
            (Maybe.Nothing))))))

  (doc ptr-eq "Checks whether two weak refs point to the same allocation.")
  (sig ptr-eq (Fn [(Ref (Weak a) q) (Ref (Weak a) r)] Bool))
  (defn ptr-eq [a-ref b-ref]
    (Pointer.eq (cptr a-ref) (cptr b-ref)))

  (doc str "Diagnostic formatting with current strong/weak counts.")
  (sig str (Fn [(Ref (Weak a) q)] String))
  (defn str [w-ref]
    (fmt "(Weak strong=%ld weak=%ld)" (strong-count w-ref) (weak-count w-ref)))
  (implements str Weak.str)

  (sig prn (Fn [(Ref (Weak a) q)] String))
  (defn prn [w-ref] (str w-ref))
  (implements prn Weak.prn))
