(load "Test.carp")
(use Test)
(load "fuzz_harness.carp")
(load "../rc.carp")

(deftype DropProbe [id Int])

(defmodule DropProbe
  (deftemplate counter-op (Fn [Int] Int)
    "int $NAME(int op)"
    "$DECL {
      static int drops = 0;
      if (op == 0) {
        drops = 0;
      } else if (op == 1) {
        drops += 1;
      }
      return drops;
    }")

  (sig reset-drops! (Fn [] ()))
  (defn reset-drops! []
    (ignore (counter-op 0)))

  (sig drops (Fn [] Int))
  (defn drops []
    (counter-op 2))

  (sig delete (Fn [DropProbe] ()))
  (defn delete [_]
    (ignore (counter-op 1)))
  (implements delete DropProbe.delete))

; A generic recursive type that indirects through Rc.
(deftype LinkNode [next (Maybe (Rc LinkNode))])

(defn build-link-chain [n]
  (let-do [link (the (Maybe (Rc LinkNode)) (Maybe.Nothing))]
    (for [i 0 n]
      (set! link (Maybe.Just (Rc.new (LinkNode.init link)))))
    link))

(defn chain-lifecycle []
  (let [chain (build-link-chain 100000)]
    (ignore chain)))

(FuzzHarness.configure-build)

(defn assert-memory-balance [state f expected-balance descr]
  (do
    (Debug.reset-memory-balance!)
    (f)
    (assert-equal state expected-balance (Debug.memory-balance) descr)))

(defn rc-lifecycle []
  (let [a (Rc.new @"hello")
        b (Rc.clone &a)
        c (Rc.clone &b)]
    (do
      (ignore (Rc.get &a))
      (ignore (Rc.get &b))
      (ignore (Rc.get &c)))))

(defn rc-try-unwrap-success-lifecycle []
  (let [r (Rc.try-unwrap (Rc.new @"unwrap-me"))]
    (match r
      (Result.Success s) (ignore s)
      (Result.Error rc) (ignore rc))))

(defn rc-make-unique-lifecycle []
  (let [a (Rc.new @"hello")
        b (Rc.clone &a)
        c (Rc.make-unique b)]
    (do
      (ignore a)
      (ignore c))))

(defn rc-weak-lifecycle []
  (let [w (let [a (Rc.new @"hello")
                w0 (Rc.downgrade &a)]
            w0)]
    (ignore (Weak.upgrade &w))))

(defn rc-weak-upgrade-lifecycle []
  (let [a (Rc.new @"hello")
        w (Rc.downgrade &a)]
    (match (Weak.upgrade &w)
      (Maybe.Just rc) (ignore rc)
      (Maybe.Nothing) ())))

(defn rc-weak-new-lifecycle []
  (let [w (the (Weak String) (Weak.new))
        w2 (Weak.clone &w)]
    (do
      (ignore (Weak.upgrade &w))
      (ignore w2))))

(deftest test
  (assert-equal test
    1l
    (let [a (Rc.new @"x")]
      (Rc.strong-count &a))
    "new starts with strong count 1")

  (assert-equal test
    3l
    (let [a (Rc.new @"x")
          b @&a
          c @&a]
      (Rc.strong-count &a))
    "copy/clone increments strong count")

  (assert-equal test
    1l
    (let [a (Rc.new @"x")]
      (do
        (let [b @&a]
          (ignore b))
        (Rc.strong-count &a)))
    "dropping a clone decrements strong count")

  (assert-equal test
    5
    (let [a (Rc.new @"hello")]
      (String.length &(Rc.get &a)))
    "get copies out the inner value")

  (assert-equal test
    true
    (let [a (Rc.new @"hello")
          b (Rc.clone &a)]
      (do
        (ignore b)
        (Rc.unique? &a)))
    "unique? reports true once clones are dropped")

  (assert-equal test
    true
    (let [a (Rc.new @"same")
          b (Rc.clone &a)]
      (Rc.ptr-eq &a &b))
    "ptr-eq is true for clones")

  (assert-equal test
    false
    (let [a (Rc.new @"left")
          b (Rc.new @"right")]
      (Rc.ptr-eq &a &b))
    "ptr-eq is false for distinct allocations")

  (assert-equal test
    5
    (match (Rc.try-unwrap (Rc.new @"hello"))
      (Result.Success s) (String.length &s)
      (Result.Error _) -1)
    "try-unwrap extracts value when unique")

  (assert-equal test
    2l
    (let [a (Rc.new @"hello")
          b (Rc.clone &a)]
      (match (Rc.try-unwrap b)
        (Result.Success _) -1l
        (Result.Error rc) (Rc.strong-count &rc)))
    "try-unwrap keeps the original Rc on failure")

  (assert-equal test
    7
    (let [a (Rc.new @"shared!")
          b (Rc.clone &a)]
      (String.length &(Rc.unwrap-or-clone b)))
    "unwrap-or-clone copies payload when shared")

  (assert-equal test
    true
    (let [a (Rc.new @"x")
          b (Rc.clone &a)
          b2 (Rc.make-unique b)]
      (and (= 1l (Rc.strong-count &a))
           (= 1l (Rc.strong-count &b2))
           (not (Rc.ptr-eq &a &b2))))
    "make-unique detaches from shared allocation")

  (assert-equal test
    6
    (String.length &(Rc.unwrap (Rc.new @"unwrap")))
    "unwrap extracts value when unique")

  (assert-equal test
    1l
    (let [a (Rc.new @"weak")
          w (Rc.downgrade &a)]
      (Rc.weak-count &a))
    "downgrade increments weak count")

  (assert-equal test
    2l
    (let [a (Rc.new @"weak")
          w1 (Rc.downgrade &a)
          w2 @&w1]
      (Weak.weak-count &w2))
    "copy/clone increments weak count")

  (assert-equal test
    true
    (let [w (the (Weak String) (Weak.new))]
      (Weak.expired? &w))
    "weak.new starts expired")

  (assert-equal test
    false
    (let [w (the (Weak String) (Weak.new))]
      (Weak.alive? &w))
    "weak.new starts not alive")

  (assert-equal test
    true
    (let [w (the (Weak String) (Weak.new))]
      (Maybe.nothing? &(Weak.upgrade &w)))
    "weak.new upgrade returns Nothing")

  (assert-equal test
    0l
    (let [w (the (Weak String) (Weak.new))]
      (Weak.strong-count &w))
    "weak.new has strong count 0")

  (assert-equal test
    0l
    (let [w (the (Weak String) (Weak.new))]
      (Weak.weak-count &w))
    "weak.new has weak count 0")

  (assert-equal test
    true
    (let [a (Rc.new @"weak")
          w (Rc.downgrade &a)]
      (match (Weak.upgrade &w)
        (Maybe.Just rc2) (Rc.ptr-eq &a &rc2)
        (Maybe.Nothing) false))
    "weak upgrade succeeds while strong refs exist")

  (assert-equal test
    true
    (let [a (Rc.new @"weak-live")
          w (Rc.downgrade &a)]
      (Weak.alive? &w))
    "weak alive? is true while strong refs exist")

  (assert-equal test
    true
    (let [w (let [a (Rc.new @"gone")]
              (Rc.downgrade &a))]
      (Weak.expired? &w))
    "weak reports expired after last strong is dropped")

  (assert-equal test
    false
    (let [w (let [a (Rc.new @"gone")]
              (Rc.downgrade &a))]
      (Weak.alive? &w))
    "weak alive? is false after last strong is dropped")

  (assert-equal test
    true
    (let [a (Rc.new @"weak-complement")
          w (Rc.downgrade &a)]
      (= (Weak.alive? &w) (not (Weak.expired? &w))))
    "weak alive? and expired? are complements while alive")

  (assert-equal test
    true
    (let [w (let [a (Rc.new @"weak-complement-gone")]
              (Rc.downgrade &a))]
      (= (Weak.alive? &w) (not (Weak.expired? &w))))
    "weak alive? and expired? are complements after expiration")

  (assert-equal test
    true
    (let [w (let [a (Rc.new @"gone")]
              (Rc.downgrade &a))]
      (Maybe.nothing? &(Weak.upgrade &w)))
    "weak upgrade returns Nothing after expiration")

  (assert-equal test
    true
    (let [w (let [a (Rc.new @"unwrap-weak")
                  w0 (Rc.downgrade &a)
                  v (Rc.unwrap a)]
              (do
                (ignore v)
                w0))]
      (Maybe.nothing? &(Weak.upgrade &w)))
    "unwrap on last strong expires existing weak refs")

  (assert-equal test
    1
    (do
      (DropProbe.reset-drops!)
      (let [w (let [a (Rc.new (DropProbe.init 1))
                    w0 (Rc.downgrade &a)]
                w0)]
        (do
          (assert (Weak.expired? &w))
          (DropProbe.drops))))
    "payload drops at strong-zero while weak refs remain")

  (assert-equal test
    1
    (do
      (DropProbe.reset-drops!)
      (let [w (let [a (Rc.new (DropProbe.init 2))
                    w0 (Rc.downgrade &a)]
                w0)]
        (ignore w))
      (DropProbe.drops))
    "payload drop runs exactly once across strong and weak teardown")

  (assert-equal test
    1
    (do
      (DropProbe.reset-drops!)
      (match (Rc.try-unwrap (Rc.new (DropProbe.init 3)))
        (Result.Success value) (ignore value)
        (Result.Error rc) (ignore rc))
      (DropProbe.drops))
    "try-unwrap unique path moves payload without double delete")

  (assert-equal test
    1
    (do
      (DropProbe.reset-drops!)
      (ignore (Rc.unwrap (Rc.new (DropProbe.init 4))))
      (DropProbe.drops))
    "unwrap unique path moves payload without double delete")

  (assert-equal test
    2l
    (let [a (Rc.new 41)
          b (Rc.clone &a)]
      (Rc.strong-count &b))
    "Rc works for non-managed payloads")

  (assert-equal test
    2
    (let [a (Rc.new [@"a" @"b"])]
      (Array.length &(Rc.get &a)))
    "Rc works for managed composite payloads")

  (assert-memory-balance test rc-lifecycle 0l "Rc clone/drop lifecycle is balanced")
  (assert-memory-balance test rc-try-unwrap-success-lifecycle 0l "Rc try-unwrap success is balanced")
  (assert-memory-balance test rc-make-unique-lifecycle 0l "Rc make-unique detach is balanced")
  (assert-memory-balance test rc-weak-lifecycle 0l "Rc weak expiration lifecycle is balanced")
  (assert-memory-balance test rc-weak-upgrade-lifecycle 0l "Rc weak upgrade lifecycle is balanced")
  (assert-memory-balance test rc-weak-new-lifecycle 0l "Rc weak.new lifecycle is balanced")

  (assert-equal test
    true
    (let [chain (build-link-chain 100000)]
      (match-ref &chain
        (Maybe.Just _) true
        (Maybe.Nothing) false))
    "dropping a 100k-deep Rc chain does not blow the C stack")
  (assert-memory-balance test chain-lifecycle 0l "100k-deep Rc chain destruction is balanced")
)
